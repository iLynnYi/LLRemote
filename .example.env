# LL Remote 环境变量示例
# 复制为 .env 或按启动命令临时注入后使用。
# 注意：Vite 只会把 VITE_* 变量暴露给前端运行时代码。

# 显示 Session 侧栏中默认折叠的开发者诊断；展开且页面可见时才采样本机 Server。
# 不控制远端能力与权限检查、分辨率、构建信息或普通错误提示。
# 可开启值：1、true、yes、on；其他值都视为关闭。
VITE_SHOW_DEBUG_INFO=0

# 本地文件日志（由 Rust 运行时读取，不会暴露给前端）。
# 开发时复制为 .env 后，Rust 会在启动时加载该文件；启动命令或系统注入的同名变量优先。
# 打包版也支持这些变量，但 macOS 从 Dock/Finder 启动通常不会继承 shell 环境；
# 请通过 launchctl 或受控 LaunchAgent 注入，并在启动后检查日志中的 logging_configured。
# VNC_LOG_LEVEL=info
# VNC_LOG_DIR=/absolute/path/to/LLRemote-logs
# VNC_LOG_MAX_FILE_SIZE_MB=10
# VNC_LOG_MAX_FILES=5
# VNC_LOG_RETENTION_DAYS=14
# 仅开发构建有效：同步已经写入文件的日志到终端；打包 release 始终忽略该项。
# VNC_LOG_STDERR=false

# Tauri dev 模式下让 Vite dev server 绑定指定 host，并同步配置 HMR host。
# 通常只在需要从局域网设备访问开发服务时设置；本机开发可保持注释。
# TAURI_DEV_HOST=192.168.1.10
