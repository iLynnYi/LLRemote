{
  "name": "LLRemote",
  "private": true,
  "author": "iLynnYi",
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --composite false -p tsconfig.node.json && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "repository:check": "node scripts/check-public-repository.mjs",
    "licenses:generate": "node scripts/distribution-licenses.mjs --generate",
    "licenses:check": "node scripts/distribution-licenses.mjs --check",
    "test": "node --test tests/frontend/**/*.test.ts",
    "test:ci": "node --test --test-reporter=tap tests/frontend/**/*.test.ts",
    "tauri": "node scripts/tauri.mjs",
    "installer:windows": "node scripts/windows-installers.mjs",
    "installer:icons": "node scripts/installer-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.5",
    "vue-tsc": "^2.1.10"
  }
}
